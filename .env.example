# ── Pipeline Configuration ──────────────────────────────────────────────────
INPUT_PATH=./SEBI CIRCULARS
OUTPUT_PATH=./output/chunks_sebi.json
SPLITTER_TYPE=recursive
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ── Groq LLM Config (Fast, Free) ──────────────────────────────────────────────
# Get key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── Google Gemini Config ──────────────────────────────────────────────────────
# Get key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Audit & Processing Settings ───────────────────────────────────────────────
AUDIT_DB_PATH=./sebi_monitor_db.sqlite
RELEVANCE_THRESHOLD=0.4
FORCE_REPROCESS=false

# ── Jev (TypeSafe AI) / OpenRouter Config ─────────────────────────────────────
TYPESAFE_API_KEY=your_typesafe_or_openrouter_key_here
# TYPESAFE_BASE_URL=https://openrouter.ai/api/v1
# TYPESAFE_MODEL=~typesafe/jev-latest

# ── Tavily AI Search (Web Search) ─────────────────────────────────────────────
# Get key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_DEPTH=basic
